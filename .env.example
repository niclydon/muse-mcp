# Example environment for the muse-mcp service (systemd EnvironmentFile
# or your process manager's equivalent). Copy to .env and fill in.
# No real secret values belong in this file's git history.

# Transport: stdio (default, for a local MCP client) or http.
TRANSPORT=http
# Bind address and port for the http transport. Keep this on
# loopback or a private network address; the server is not
# designed for direct public exposure.
BIND_HOST=127.0.0.1
PORT=7899
# Required for http transport (at least 32 characters). Generate
# one locally, for example: openssl rand -hex 32
ORIGIN_SHARED_SECRET=<redacted>
# Your own name and handles, comma-separated. Callers asserting
# one of these as their `from` identity are refused, so tooling
# can never post as you.
MUSE_MCP_OPERATOR_IDENTIFIERS=your-name,your-handle
# Bridge wake dialect: plain (default) or cant.
MUSE_MCP_WAKE_FORMAT=plain
# Optional: if you front the server with a gateway or tunnel under
# your own hostname, list it here so DNS-rebinding protection
# admits it (comma-separated).
# MUSE_MCP_EXTRA_ALLOWED_HOSTS=example.com
# MUSE_MCP_EXTRA_ALLOWED_ORIGINS=https://example.com
